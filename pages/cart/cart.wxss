/* cart.wxss - The Botanical Atelier 青绿色主题 */

/* 主容器 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: #f8faf8;
  min-height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
  padding-bottom: 300rpx;
}

/* 顶部导航栏 */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx 60rpx;
  background: rgba(248, 250, 248, 0.7);
  backdrop-filter: blur(40rpx);
  -webkit-backdrop-filter: blur(40rpx);
  border-bottom-left-radius: 96rpx;
  border-bottom-right-radius: 96rpx;
  box-shadow: 0 8rpx 64rpx rgba(75, 102, 74, 0.05);
  width: 100%;
  box-sizing: border-box;
  height: 160rpx;
}

.header-left, .header-right {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.back-btn, .more-btn {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  line-height: 1;
}

.back-icon {
  font-size: 64rpx;
  color: #4b664a;
  font-weight: 300;
}

.more-icon {
  font-size: 40rpx;
  color: #4b664a;
  font-weight: bold;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4b664a;
  letter-spacing: -0.5rpx;
}

/* 主内容区 */
.main-content {
  margin-top: 210rpx;
  padding: 0 48rpx;
  width: 100%;
  box-sizing: border-box;
}

/* 空购物车 */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(75, 102, 74, 0.04);
  border: 2rpx solid rgba(172, 180, 177, 0.1);
}

.empty-icon {
  font-size: 160rpx;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-text {
  font-size: 30rpx;
  color: #59615f;
  margin-bottom: 48rpx;
}

.empty-button {
  padding: 24rpx 64rpx;
  background: linear-gradient(135deg, #4b664a 0%, #3f593f 100%);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 40rpx rgba(75, 102, 74, 0.2);
}

.empty-button:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 购物车列表 */
.cart-list {
  display: flex;
  flex-direction: column;
}

/* 全选头部 */
.select-all-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 16rpx 16rpx;
}

.select-all-left {
  display: flex;
  align-items: center;
  gap: 32rpx;
}

.checkbox-wrapper {
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkbox {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 4rpx solid #acb4b1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
  background: transparent;
}

.checkbox.checked {
  background: #4b664a;
  border-color: #4b664a;
}

.check-icon {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: bold;
}

.select-all-label {
  font-size: 24rpx;
  color: #2d3432;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.batch-delete-btn {
  padding: 16rpx 32rpx;
  background: transparent;
  border-radius: 24rpx;
  transition: all 0.2s ease;
}

.batch-delete-btn:active {
  background: #f1f4f2;
}

.batch-delete-text {
  font-size: 28rpx;
  color: #4b664a;
  font-weight: 700;
}

/* 商品列表容器 */
.items-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 商品卡片 */
.cart-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 32rpx;
  background: #ffffff;
  border-radius: 48rpx;
  box-shadow: 0 8rpx 32rpx rgba(75, 102, 74, 0.04);
  border: 2rpx solid rgba(172, 180, 177, 0.05);
}

.item-image-wrapper {
  width: 224rpx;
  height: 224rpx;
  flex-shrink: 0;
  border-radius: 32rpx;
  overflow: hidden;
  background: #f1f4f2;
}

.item-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  opacity: 0.9;
}

.item-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.item-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2d3432;
  line-height: 1.3;
  flex: 1;
  margin-right: 16rpx;
}

.delete-btn {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.delete-icon {
  font-size: 32rpx;
  color: #acb4b1;
  font-weight: 300;
}

.item-desc {
  font-size: 24rpx;
  color: #59615f;
  margin-bottom: 16rpx;
}

.item-footer {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-top: auto;
}

.item-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #4b664a;
}

/* 数量控制 */
.quantity-control {
  display: flex;
  align-items: center;
  background: #f1f4f2;
  border-radius: 64rpx;
  padding: 8rpx;
}

.qty-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}

.qty-btn:active {
  opacity: 0.7;
}

.qty-icon {
  font-size: 32rpx;
  color: #59615f;
  font-weight: 400;
}

.qty-value {
  width: 80rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #2d3432;
}

/* 猜你喜欢 */
.recommend-section {
  margin-top: 96rpx;
  margin-bottom: 48rpx;
}

.recommend-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #2d3432;
  margin-bottom: 48rpx;
  padding-left: 16rpx;
}

.recommend-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 32rpx;
}

.recommend-item {
  background: #f1f4f2;
  border-radius: 48rpx;
  padding: 32rpx;
}

.recommend-image-wrapper {
  aspect-ratio: 1;
  border-radius: 32rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.recommend-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.recommend-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #2d3432;
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recommend-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #4b664a;
  margin-top: 8rpx;
  display: block;
}



/* 底部结算栏 */
.checkout-bar {
  position: fixed;
  bottom: 100rpx;
  left: 0;
  right: 0;
  z-index: 50;
  background: rgba(248, 250, 248, 0.8);
  backdrop-filter: blur(64rpx);
  -webkit-backdrop-filter: blur(64rpx);
  padding: 32rpx 48rpx 80rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top-left-radius: 96rpx;
  border-top-right-radius: 96rpx;
  box-shadow: 0 -20rpx 80rpx rgba(75, 102, 74, 0.08);
}

.checkout-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.checkout-label {
  font-size: 20rpx;
  color: #acb4b1;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 4rpx;
}

.checkout-total {
  font-size: 48rpx;
  font-weight: 800;
  color: #2d3432;
  line-height: 1;
}

.checkout-btn {
  padding: 32rpx 80rpx;
  background: linear-gradient(135deg, #4b664a 0%, #3f593f 100%);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 30rpx;
  font-weight: 700;
  box-shadow: 0 12rpx 40rpx rgba(75, 102, 74, 0.2);
}

.checkout-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}

/* 响应式设计 */
@media (max-width: 375px) {
  .cart-item {
    padding: 32rpx;
    gap: 24rpx;
  }
  
  .item-image-wrapper {
    width: 180rpx;
    height: 180rpx;
  }
  
  .item-title {
    font-size: 28rpx;
  }
  
  .item-price {
    font-size: 36rpx;
  }
  
  .checkout-total {
    font-size: 40rpx;
  }
  
  .checkout-btn {
    padding: 28rpx 64rpx;
    font-size: 28rpx;
  }
}
