/* cart.wxss - 糖果立绘风格 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF0F3 100%);
  min-height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Header */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.1);
}

.back-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border-radius: 50%;
  transition: all 0.3s ease;
  border: 2rpx solid #FFCDD8;
}

.back-button:active {
  transform: scale(0.95);
  background: #FFD6E0;
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF758F;
}

.header-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

.header-placeholder {
  width: 56rpx;
  height: 56rpx;
}

/* Cart Section */
.cart-section {
  margin-top: 104rpx;
  padding: 24rpx;
  min-height: calc(100vh - 104rpx);
}

/* Empty Cart */
.empty-cart {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 24rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  border-radius: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 163, 0.1);
  border: 2rpx solid #FFE5EC;
}

.empty-icon {
  font-size: 144rpx;
  margin-bottom: 32rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6b7280;
  margin-bottom: 48rpx;
}

.empty-button {
  padding: 24rpx 56rpx;
  background: linear-gradient(135deg, #FF8FA3 0%, #FF758F 100%);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 20rpx rgba(255, 143, 163, 0.35);
  transition: all 0.3s ease;
}

.empty-button:active {
  transform: scale(0.98);
  background: #FF758F;
  box-shadow: 0 3rpx 12rpx rgba(255, 143, 163, 0.25);
}

/* Cart Items */
.cart-items {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  border-radius: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 163, 0.1);
  overflow: hidden;
  border: 2rpx solid #FFE5EC;
}

.cart-items {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  border-radius: 36rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 163, 0.1);
  overflow: hidden;
  border: 2rpx solid #FFE5EC;
}

/* Select All Row */
.select-all-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 2rpx solid #FFE5EC;
  background: linear-gradient(145deg, #FFF8F9 0%, #FFF0F3 100%);
}

/* Checkbox */
.checkbox {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  transition: all 0.3s ease;
  min-width: 80rpx;
  min-height: 48rpx;
  justify-content: flex-start;
}

.checkbox:active {
  background: #FFE5EC;
  transform: scale(0.95);
}

.checkbox-icon {
  font-size: 36rpx;
  display: inline-block;
  width: 40rpx;
  text-align: center;
}

.select-all-text {
  font-size: 26rpx;
  color: #6b7280;
  font-weight: 600;
}

/* Batch Delete Button */
.batch-delete-button {
  padding: 12rpx 24rpx;
  background: linear-gradient(135deg, #FF6B7A 0%, #FF8FAB 100%);
  border-radius: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 122, 0.3);
  transition: all 0.3s ease;
  border: 2rpx solid #FF5A6A;
}

.batch-delete-button:active {
  transform: scale(0.95);
  box-shadow: 0 2rpx 8rpx rgba(255, 107, 122, 0.2);
}

.batch-delete-text {
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* Cart Items */
.cart-item {
  display: flex;
  gap: 20rpx;
  padding: 28rpx;
  border-bottom: 2rpx solid #FFE5EC;
  transition: all 0.3s ease;
  align-items: flex-start;
}

.cart-item:last-child {
  border-bottom: none;
}

.cart-item:active {
  background: #FFF5F5;
}

.item-image {
  width: 140rpx;
  height: 196rpx;
  flex-shrink: 0;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.12);
  transition: all 0.3s ease;
}

.item-image:active {
  transform: scale(0.98);
}

.book-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
  line-height: 1.3;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-author {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 12rpx;
}

/* Item Tags */
.item-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-weight: 600;
}

.condition-tag {
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border: 1rpx solid #FFCDD8;
  color: #FF758F;
}

.category-tag {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border: 1rpx solid #A5D6A7;
  color: #4CAF50;
}

.item-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.current-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8FA3;
}

.original-price {
  font-size: 20rpx;
  color: #9ca3af;
  text-decoration: line-through;
}

.item-actions {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.quantity-control {
  display: flex;
  align-items: center;
  gap: 16rpx;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFE5EC 100%);
  border-radius: 16rpx;
  padding: 8rpx;
  border: 2rpx solid #FFE5EC;
}

.quantity-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFFFFF 0%, #FFF8F9 100%);
  border-radius: 12rpx;
  transition: all 0.3s ease;
  border: 1rpx solid #FFE5EC;
}

.quantity-button:active {
  background: #FFD6E0;
  transform: scale(0.95);
}

.quantity-icon {
  font-size: 26rpx;
  color: #FF758F;
  font-weight: bold;
}

.quantity {
  font-size: 26rpx;
  color: #1f2937;
  font-weight: 600;
  min-width: 48rpx;
  text-align: center;
}

.delete-button {
  padding: 16rpx;
  background: linear-gradient(145deg, #FFF0F3 0%, #FFE5EC 100%);
  border-radius: 16rpx;
  transition: all 0.3s ease;
  border: 2rpx solid #FFCDD8;
  min-width: 60rpx;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.delete-button:active {
  background: #FFD6E0;
  transform: scale(0.95);
}

.delete-icon {
  font-size: 28rpx;
}

/* Checkout Section */
.checkout-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(255, 143, 163, 0.12);
  z-index: 99;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-top: 2rpx solid #FFE5EC;
}

.checkout-info {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.total-label {
  font-size: 26rpx;
  color: #6b7280;
}

.total-price {
  font-size: 40rpx;
  font-weight: 700;
  color: #FF8FA3;
}

.checkout-button {
  padding: 24rpx 56rpx;
  background: linear-gradient(135deg, #FF8FA3 0%, #FF758F 100%);
  color: #ffffff;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 700;
  transition: all 0.3s ease;
  box-shadow: 0 6rpx 20rpx rgba(255, 143, 163, 0.35);
}

.checkout-button:active {
  transform: scale(0.98);
  background: #FF758F;
  box-shadow: 0 3rpx 12rpx rgba(255, 143, 163, 0.25);
}

/* 购物车悬浮按钮 */
.cart-floating-button {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25), 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.cart-floating-button:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-icon {
  font-size: 44rpx;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffd93d;
  color: #2d3436;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* Responsive Design */
@media (max-width: 375px) {
  .item-image {
    width: 140rpx;
    height: 196rpx;
  }

  .item-title {
    font-size: 26rpx;
  }

  .current-price {
    font-size: 30rpx;
  }

  .total-price {
    font-size: 34rpx;
  }

  .checkout-button {
    padding: 20rpx 44rpx;
    font-size: 24rpx;
  }
}
