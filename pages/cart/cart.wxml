<view class="container">
  <!-- 顶部导航栏 -->
  <view class="header" style="position: fixed; left: 0rpx; top: 0rpx; height: 210rpx; display: flex; box-sizing: border-box">
    <view class="header-left">
      <view class="back-btn" bindtap="goBack" style="position: relative; left: 0rpx; top: 0rpx">
        <text class="back-icon" style="width: 64rpx; display: block; box-sizing: border-box; position: relative; left: 1rpx; top: 25rpx; height: 62rpx">‹</text>
      </view>
    </view>
    <text class="header-title" style="position: relative; left: -1rpx; top: 23rpx">购物车</text>
    <view class="header-right">
      <view class="more-btn">
        
      </view>
    </view>
  </view>

  <!-- 主内容区 -->
  <view class="main-content">
    <!-- 空购物车 -->
    <view wx:if="{{cartItems.length === 0}}" class="empty-cart">
      <text class="empty-icon">🛒</text>
      <text class="empty-text">购物车为空</text>
      <view class="empty-button" bindtap="goToBooks">去逛逛</view>
    </view>

    <!-- 购物车列表 -->
    <view wx:else class="cart-list">
      <!-- 全选头部 -->
      <view class="select-all-header">
        <view class="select-all-left">
          <view class="checkbox-wrapper" bindtap="toggleSelectAll">
            <view class="checkbox {{selectedAll ? 'checked' : ''}}">
              <text wx:if="{{selectedAll}}" class="check-icon">✓</text>
            </view>
          </view>
          <text class="select-all-label">全选</text>
        </view>
        <view wx:if="{{selectedIds.length > 0}}" class="batch-delete-btn" bindtap="batchDelete">
          <text class="batch-delete-text">删除 ({{selectedIds.length}})</text>
        </view>
      </view>

      <!-- 商品列表 -->
      <view class="items-container">
        <view wx:for="{{cartItems}}" wx:key="_id" class="cart-item">
          <view class="checkbox-wrapper" data-id="{{item._id}}" bindtap="toggleSelect">
            <view class="checkbox {{selectedIds.includes(item._id) ? 'checked' : ''}}">
              <text wx:if="{{selectedIds.includes(item._id)}}" class="check-icon">✓</text>
            </view>
          </view>
          <view class="item-image-wrapper" data-book-id="{{item.bookId}}" bindtap="goToBookDetail">
            <image src="{{item.bookImage}}" mode="aspectFill" class="item-image" />
          </view>
          <view class="item-content">
            <view class="item-header">
              <text class="item-title">{{item.bookTitle}}</text>
              <view class="delete-btn" data-id="{{item._id}}" bindtap="deleteItem">
                <text class="delete-icon">×</text>
              </view>
            </view>
            <text class="item-desc">{{item.bookAuthor || '暂无作者信息'}}</text>
            <view class="item-footer">
              <text class="item-price">¥{{item.bookPrice}}</text>
              <view class="quantity-control">
                <view class="qty-btn" data-id="{{item._id}}" data-type="decrease" bindtap="changeQuantity">
                  <text class="qty-icon">−</text>
                </view>
                <text class="qty-value">{{item.quantity}}</text>
                <view class="qty-btn" data-id="{{item._id}}" data-type="increase" bindtap="changeQuantity">
                  <text class="qty-icon">+</text>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>

      <!-- 猜你喜欢 -->
      <view class="recommend-section">
        <text class="recommend-title">猜你喜欢</text>
        <view class="recommend-grid">
          <view class="recommend-item">
            <view class="recommend-image-wrapper">
              <image src="https://images.unsplash.com/photo-1544947950-fa07a98d237f?w=400" mode="aspectFill" class="recommend-image" />
            </view>
            <text class="recommend-name">计算机网络</text>
            <text class="recommend-price">¥45.00</text>
          </view>
          <view class="recommend-item">
            <view class="recommend-image-wrapper">
              <image src="https://images.unsplash.com/photo-1532012197267-da84d127e765?w=400" mode="aspectFill" class="recommend-image" />
            </view>
            <text class="recommend-name">数据结构</text>
            <text class="recommend-price">¥38.00</text>
          </view>
        </view>
      </view>
    </view>
  </view>



  <!-- 底部结算栏 -->
  <view wx:if="{{cartItems.length > 0}}" class="checkout-bar">
    <view class="checkout-info">
      <text class="checkout-label">合计结算</text>
      <text class="checkout-total">¥{{totalPrice}}</text>
    </view>
    <view class="checkout-btn" bindtap="checkout">结算订单</view>
  </view>
</view>
