/* publish.wxss - 糖果立绘风格 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF0F3 100%);
  min-height: 100vh;
  padding-bottom: 120rpx; /* 为底部导航栏留出空间 */
}

/* 自定义导航栏 */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.1);
}

.navbar-content {
  display: flex;
  justify-content: center;
  width: 100%;
}

.navbar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
}

/* 表单容器 */
.form-container {
  margin-top: 104rpx;
  padding: 32rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  border-radius: 36rpx;
  margin: 104rpx 16rpx 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 163, 0.12);
  border: 2rpx solid #FFE5EC;
}

/* 输入组 */
.input-group {
  margin-bottom: 48rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 20rpx;
}

.input {
  width: 100%;
  padding: 28rpx 24rpx;
  border: 2rpx solid #FFE5EC;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #374151;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFF0F3 100%);
  box-sizing: border-box;
  min-height: 100rpx;
  line-height: 1.4;
  transition: all 0.3s ease;
}

.input::placeholder {
  color: #FF8FA3;
}

.input:focus {
  outline: none;
  border-color: #FF8FA3;
  box-shadow: 0 0 0 4rpx rgba(255, 143, 163, 0.15);
  background: #FFFFFF;
}

/* 价格输入容器 */
.price-input-container {
  display: flex;
  align-items: center;
  border: 2rpx solid #FFE5EC;
  border-radius: 24rpx;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFF0F3 100%);
  overflow: hidden;
}

.currency {
  padding: 28rpx 16rpx 28rpx 24rpx;
  font-size: 28rpx;
  color: #FF758F;
  font-weight: 700;
  background: rgba(255, 230, 236, 0.5);
}

.price-input {
  flex: 1;
  padding: 28rpx 24rpx 28rpx 0;
  border: none;
  font-size: 28rpx;
  color: #374151;
  background: transparent;
}

.price-input::placeholder {
  color: #FF8FA3;
}

.price-input:focus {
  outline: none;
}

/* 选择器 */
.picker {
  width: 100%;
  padding: 28rpx 24rpx;
  border: 2rpx solid #FFE5EC;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #374151;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFF0F3 100%);
  box-sizing: border-box;
  min-height: 100rpx;
  line-height: 1.4;
  transition: all 0.3s ease;
}

.picker.placeholder {
  color: #FF8FA3;
}

.picker.selected {
  color: #374151;
}

/* 文本域 */
.textarea {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #FFE5EC;
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #374151;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFF0F3 100%);
  box-sizing: border-box;
  min-height: 240rpx;
  transition: all 0.3s ease;
}

.textarea::placeholder {
  color: #FF8FA3;
}

.textarea:focus {
  outline: none;
  border-color: #FF8FA3;
  box-shadow: 0 0 0 4rpx rgba(255, 143, 163, 0.15);
  background: #FFFFFF;
}

/* 图片上传 */
.image-upload {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 180rpx;
  height: 252rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #FFF5F5;
  border: 2rpx solid #FFE5EC;
  box-shadow: 0 4rpx 12rpx rgba(255, 143, 163, 0.1);
}

.uploaded-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.delete-image {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 117, 143, 0.9);
  color: white;
  border-radius: 50%;
  font-size: 24rpx;
  font-weight: bold;
  z-index: 10;
}

.upload-button {
  width: 180rpx;
  height: 252rpx;
  border: 3rpx dashed #FFCDD8;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFE5EC 100%);
  transition: all 0.3s ease;
}

.upload-button:active {
  background: #FFD6E0;
  border-color: #FF8FA3;
}

.upload-icon {
  font-size: 56rpx;
  color: #FF8FA3;
  margin-bottom: 12rpx;
}

.upload-text {
  font-size: 22rpx;
  color: #FF758F;
  font-weight: 600;
}

/* 提交按钮 */
.submit-button {
  width: 100%;
  padding: 32rpx;
  background: linear-gradient(135deg, #FF8FA3 0%, #FF758F 100%);
  border: none;
  border-radius: 32rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 163, 0.35);
  transition: all 0.3s ease;
}

.submit-button:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.25);
}

.submit-button:disabled {
  background: linear-gradient(135deg, #FFB4C2 0%, #FFA0B0 100%);
  cursor: not-allowed;
  box-shadow: none;
}

/* 购物车悬浮按钮 */
.cart-floating-button {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25), 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.cart-floating-button:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-icon {
  font-size: 44rpx;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffd93d;
  color: #2d3436;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}