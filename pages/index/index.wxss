/* 动漫插画风样式 - index.wxss */

.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  min-height: 100vh;
  padding-bottom: 200rpx; /* 为底部自定义导航栏预留更多空间 */
  position: relative;
  overflow: auto;
  background-color: #f8f9ff;
}

/* 内容区域容器 */
.content-container {
  margin: 24rpx;
  padding: 32rpx;
  background-color: #ffffff;
  border: 8rpx solid #f59e0b;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.15), 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  position: relative;
  z-index: 1;
  background-image: linear-gradient(145deg, #fef3c7 0%, #ffffff 100%);
  margin-bottom: 40rpx;
}

/* 四个角的图片样式 */
.corner-image {
  position: absolute;
  width: 60rpx;
  height: 60rpx;
  z-index: 2;
}

.corner-top-left {
  top: -8rpx;
  left: -8rpx;
}

.corner-top-right {
  top: -8rpx;
  right: -8rpx;
}

.corner-bottom-left {
  bottom: -8rpx;
  left: -8rpx;
}

.corner-bottom-right {
  bottom: -8rpx;
  right: -8rpx;
}

.content-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 12rpx;
  background: linear-gradient(90deg, #10b981 0%, #f59e0b 50%, #ef4444 100%);
  border-radius: 16rpx 16rpx 0 0;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* 背景图片 */
.background-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  z-index: 0;
}

/* 保留原有的所有样式... */

