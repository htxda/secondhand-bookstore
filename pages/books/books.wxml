<view class="container">
  <view class="hero-card">
    <view class="hero-text">
      <text class="greeting">欢迎光临藏书库</text>
      <text class="headline">今天淘哪本好书？</text>
    </view>
    
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input 
        placeholder="搜索书名、作者、科目..." 
        placeholder-class="search-placeholder"
        class="search-input" 
        value="{{searchKeyword}}"
        bindinput="searchInput"
        bindconfirm="searchSubmit"
      />
    </view>
  </view>

  <view class="books-section">
    <view class="books-grid">
      <view wx:for="{{books}}" wx:key="_id" class="book-card" data-id="{{item._id}}" bindtap="bookTap">
        <image src="{{item.images[0] || item.image || 'https://via.placeholder.com/300x400.png?text=Book'}}" mode="aspectFill" class="book-image" />
        <view class="book-info">
          <text class="book-title">{{item.title}}</text>
          <text class="book-author">{{item.author}}</text>
          
          <view class="book-tags">
            <text class="tag condition-tag">{{item.condition || '九成新'}}</text>
            <text class="tag category-tag">{{item.category || '分类'}}</text>
          </view>
          
          <view class="book-price">
            <text class="current-price">¥{{item.price}}</text>
            <text class="original-price" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view
    class="cart-floating-button"
    bindtap="goToCart"
    bindtouchstart="touchStart"
    bindtouchmove="touchMove"
    bindtouchend="touchEnd"
    style="top: 1302rpx; left: 627rpx; position: fixed"
  >
    <text class="cart-icon">🛒</text>
    <text class="cart-badge" wx:if="{{cartCount > 0}}">{{cartCount}}</text>
  </view>
</view>