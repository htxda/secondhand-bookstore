/* books.wxss - 白色背景风格 */

page {
  background: linear-gradient(135deg, #f8f5f0 0%, #faf7f2 100%);
  padding: 0;
  margin: 0;
  /* 加上这句 */
  background-attachment: fixed;
}

.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  min-height: 100vh;
  color: #333333;
  padding-bottom: 150rpx;
}

/* --- 顶部 Hero Card --- */
.hero-card {
  margin: 24rpx;
  padding: 48rpx 32rpx 40rpx;
  /* 荧光绿渐变 */
  background: linear-gradient(135deg, #CCFF00 0%, #99CC00 100%);
  border-radius: 40rpx;
  box-shadow: 0 16rpx 40rpx rgba(204, 255, 0, 0.15);
  position: relative;
  overflow: hidden;
}

.hero-text {
  display: flex;
  flex-direction: column;
  margin-bottom: 36rpx;
  position: relative;
  z-index: 2;
}

.greeting {
  font-size: 30rpx;
  color: rgba(0, 0, 0, 0.721);
  margin-bottom: 8rpx;
  font-weight: 550;
}

.headline {
  font-size: 44rpx;
  font-weight: 800;
  color: #000000;
  letter-spacing: 2rpx;
}

/* --- 搜索栏 (玻璃拟态 Glassmorphism) --- */
.search-bar {
  display: flex;
  align-items: center;
  /* 半透明白色背景，实现毛玻璃质感，增加对比度 */
  background: rgba(255, 255, 255, 0.459);
  backdrop-filter: blur(15rpx);
  -webkit-backdrop-filter: blur(15rpx);
  
  border: 8rpx solid #ffffff; /* 添加白色边框 */
  border-radius: 40rpx;
  padding: 24rpx 36rpx;
  position: relative;
  z-index: 2;
  box-shadow: 0 8rpx 24rpx rgba(204, 255, 0, 0.2);
  transition: all 0.3s ease;
}

.search-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  opacity: 1;
  color: #000000;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
  color: #000000;
  font-weight: 600;
  text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.1);
}

.search-placeholder {
  color: rgba(0, 0, 0, 0.6);
  font-weight: 500;
}

/* --- 书籍列表区域 --- */
.books-section {
  padding: 0 24rpx;
}

/* 2x2 网格布局 */
.books-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
}

/* 明亮绿色渐变书籍卡片 */
.book-card {
  background: linear-gradient(135deg, #CCFF00 0%, #99CC00 100%);
  border: 2rpx solid #88AA00;
  border-radius: 32rpx;
  padding: 16rpx;
  display: flex;
  flex-direction: column;
  box-shadow: 0 8rpx 24rpx rgba(204, 255, 0, 0.2);
  transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.book-card:active {
  transform: scale(0.96);
}

.book-image {
  width: 100%;
  height: 210rpx;
  border-radius: 16rpx;
  object-fit: cover;
  margin-bottom: 16rpx;
  margin-left: -10rpx; /* 向左移动10rpx */
  background-color: #f5f5f5; /* 图片加载前的骨架屏颜色 */
  border: 6rpx solid #ffffff; /* 添加白色边框 */
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1); /* 增强边框效果 */
}

.book-info {
  display: flex;
  flex-direction: column;
  flex: 1;
}

.book-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #000000;
  line-height: 1.4;
  margin-bottom: 4rpx;
  display: -webkit-box;
  -webkit-line-clamp: 2; /* 限制标题最多两行 */
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
}

.book-author {
  font-size: 24rpx;
  color: rgba(0, 0, 0, 0.8);
  margin-bottom: 12rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

.book-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-bottom: 16rpx;
  margin-top: auto; /* 将价格和标签推到底部 */
}

/* 标签样式 */
.tag {
  font-size: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.8); /* 半透明白色背景 */
  border: 1rpx solid rgba(255, 255, 255, 0.9);
  color: #000000;
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.book-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.current-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #000000;
  text-shadow: 0 1rpx 2rpx rgba(255, 255, 255, 0.5);
}

.original-price {
  font-size: 22rpx;
  color: rgba(0, 0, 0, 0.6);
  text-decoration: line-through;
  text-shadow: 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

/* --- 购物车悬浮按钮 --- */
.cart-floating-button {
  background: #ffffff;
  border: 4rpx solid #CCFF00;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 110rpx;
  height: 110rpx;
  box-shadow: 0 8rpx 32rpx rgba(204, 255, 0, 0.25);
  z-index: 100;
  transition: all 0.2s ease;
}

.cart-floating-button:active {
  transform: scale(0.9);
  background: #f0f0f0;
}

.cart-icon {
  font-size: 48rpx;
  color: #000000;
}

.cart-badge {
  position: absolute;
  top: -6rpx;
  right: -6rpx;
  background: #CCFF00;
  color: #000000;
  font-size: 22rpx;
  font-weight: 800;
  min-width: 40rpx;
  height: 40rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #ffffff;
}