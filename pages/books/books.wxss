/* books.wxss - 糖果立绘风格 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF0F3 100%);
  min-height: 100vh;
}

/* Search Section - 糖果风格 */
.search-section {
  padding: 24rpx;
  background: linear-gradient(145deg, #FFF5F5 0%, #FFF0F3 100%);
  border-bottom: 2rpx solid #FFE5EC;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.1);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.95);
  border: 2rpx solid #FFE5EC;
  border-radius: 32rpx;
  padding: 24rpx 28rpx;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.1);
}

.search-bar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 32rpx;
}

.search-bar:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(255, 143, 163, 0.08);
}

.search-icon {
  font-size: 32rpx;
  color: #FF8FA3;
  margin-right: 16rpx;
  position: relative;
  z-index: 1;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
  color: #374151;
  background: transparent;
  border: none;
  outline: none;
  position: relative;
  z-index: 1;
}

.search-input::placeholder {
  color: #FF8FA3;
}

/* Books Section */
.books-section {
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 2rpx solid #FFE5EC;
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8FA3 0%, #D4A5FF 100%);
  border-radius: 3rpx;
}

.books-container {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* 糖果风格书籍卡片 */
.book-item {
  display: flex;
  gap: 24rpx;
  background: linear-gradient(160deg, #FFFFFF 0%, #FFF8F9 50%, #FFF0F3 100%);
  border: 2rpx solid #FFE5EC;
  border-radius: 32rpx;
  padding: 28rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 143, 163, 0.1);
  transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  position: relative;
  overflow: hidden;
}

.book-item::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 6rpx;
  height: 100%;
  background: linear-gradient(180deg, #FF8FA3 0%, #D4A5FF 100%);
  border-radius: 3rpx 0 0 3rpx;
}

.book-item:active {
  transform: translateY(-4rpx) scale(0.99);
  box-shadow: 0 12rpx 32rpx rgba(255, 143, 163, 0.15);
}

.book-image {
  width: 160rpx;
  height: 224rpx;
  border-radius: 20rpx;
  object-fit: cover;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  transition: all 0.3s ease;
}

.book-item:active .book-image {
  transform: scale(1.02);
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.book-title {
  font-size: 28rpx;
  font-weight: 700;
  color: #1f2937;
  line-height: 1.3;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
}

.book-author {
  font-size: 22rpx;
  color: #6b7280;
  margin-bottom: 16rpx;
}

.book-tags {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.tag {
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

/* 糖果风格标签 */
.condition-tag {
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border: 1rpx solid #FFCDD8;
  color: #FF758F;
}

.subject-tag {
  background: #f3f4f6;
  color: #6b7280;
}

.book-price {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.current-price {
  font-size: 36rpx;
  font-weight: 700;
  color: #FF8FA3;
  text-shadow: 0 2rpx 4rpx rgba(255, 143, 163, 0.2);
}

.original-price {
  font-size: 20rpx;
  color: #9ca3af;
  text-decoration: line-through;
}

.rating {
  display: flex;
  align-items: center;
  gap: 6rpx;
  background: #FFF8E1;
  padding: 6rpx 14rpx;
  border-radius: 14rpx;
}

.star {
  font-size: 22rpx;
}

.rating-value {
  font-size: 22rpx;
  color: #6b7280;
  font-weight: 600;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 24rpx;
  text-align: center;
}

.empty-icon {
  font-size: 128rpx;
  margin-bottom: 32rpx;
  opacity: 0.5;
}

.empty-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 16rpx;
}

.empty-message {
  font-size: 24rpx;
  color: #6b7280;
  line-height: 1.5;
}

/* Loading State */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 128rpx 24rpx;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #FFE5EC;
  border-top: 4rpx solid #FF8FA3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 24rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #6b7280;
}

/* 购物车悬浮按钮 */
.cart-floating-button {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25), 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.cart-floating-button:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-icon {
  font-size: 44rpx;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffd93d;
  color: #2d3436;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* Responsive Design */
@media (max-width: 375px) {
  .book-image {
    width: 140rpx;
    height: 200rpx;
  }

  .book-title {
    font-size: 24rpx;
  }

  .current-price {
    font-size: 30rpx;
  }
}
