/* pages/index/index.wxss */

/* 页面默认样式（核心：消除下拉空白） */
page {
  background: linear-gradient(135deg, #f8f5f0 0%, #faf7f2 100%);
  padding: 0;
  margin: 0;
  /* 禁用原生下拉回弹，彻底消除顶部空白 */
  overscroll-behavior: none;
  /* 固定背景，滚动不偏移 */
  background-attachment: fixed;
}

/* ══════════════════════════════════════
   色彩变量（手动维护）
   主色  ：#A8E636  柠檬绿
   辅色  ：#C5F243  亮柠檬
   暗绿  ：#7ED321
   卡片  ：#181818
   浅灰  ：#B0B0B0
   深灰  ：#2D2D2D
   紫色  ：#9D4EDD
   粉色  ：#FF6B6B
══════════════════════════════════════ */

/* ── 根容器（适配刘海屏+消除空白） ─────────────────────────── */
.page-root {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  background: linear-gradient(135deg, #f8f5f0 0%, #faf7f2 100%);
  overflow: hidden;
  /* 适配iPhone状态栏安全区，避免顶部截断/空白 */
  padding-top: env(safe-area-inset-top);
  margin-top: 0;
}

/* ── 滚动区域（核心：独立滚动，避免页面整体下滑） ───────────────────────── */
.scroll-area {
  box-sizing: border-box;
  width: 100%;
  background: linear-gradient(135deg, #f8f5f0 0%, #faf7f2 100%);
  /* 适配安全区，和根容器对齐 */
  padding-top: 0;
  padding-bottom: 150rpx;
  margin-top: 0;
  /* 核心：滚动区域独立，高度占满屏幕 */
  flex: 1;
  overflow-y: auto;
  /* 消除滚动回弹空白 */
  background-attachment: local;
}

/* ══════════════════════════════════════
   Hero 横幅（适配安全区，避免顶部空白）
══════════════════════════════════════ */
.hero-banner {
  /* 适配状态栏安全区，替换原有margin-top:0 */
  margin: env(safe-area-inset-top) 28rpx 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #6BBF00 0%, #A8E636 50%, #C5F243 100%);
  position: relative;
  overflow: hidden;
  height: 340rpx;
}

.hero-deco-circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.12);
}
.deco-1 {
  width: 360rpx;
  height: 360rpx;
  right: -80rpx;
  top: -80rpx;
}
.deco-2 {
  width: 200rpx;
  height: 200rpx;
  left: -40rpx;
  bottom: -60rpx;
  background: rgba(0, 0, 0, 0.08);
}

.hero-content {
  position: relative;
  z-index: 2;
  padding: 44rpx 0 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.hero-greeting {
  font-size: 26rpx;
  color: rgba(0, 0, 0, 0.6);
  font-weight: 500;
  letter-spacing: 1rpx;
}

.hero-title {
  font-size: 48rpx;
  font-weight: 900;
  color: #000000;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.hero-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #000000;
  border-radius: 100rpx;
  padding: 18rpx 40rpx;
  width: fit-content;
  margin-top: 10rpx;
  box-shadow: 0 8rpx 24rpx rgba(0, 0, 0, 0.35);
  transition: opacity 0.15s;
}
.hero-btn--active {
  opacity: 0.8;
  transform: scale(0.97);
}

.hero-btn-icon {
  font-size: 24rpx;
  color: #A8E636;
}
.hero-btn-text {
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
}

.hero-student {
  position: absolute;
  right: 50rpx;
  bottom: 0;
  height: 350rpx;
  width: 200rpx;
  z-index: 3;
  /* 若图片背景透明则效果最佳 */
  filter: drop-shadow(0 8rpx 24rpx rgba(0,0,0,0.25));
}

/* ══════════════════════════════════════
   统计卡片组
══════════════════════════════════════ */
.stats-row {
  display: flex;
  gap: 18rpx;
  margin: 28rpx 28rpx 0;
}

.stat-card {
  flex: 1;
  background: #181818;
  border-radius: 32rpx;
  padding: 32rpx 14rpx 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  box-shadow: 0 4rpx 24rpx rgba(0, 0, 0, 0.5), inset 0 2rpx 0 rgba(255,255,255,0.04);
  transition: border 0.2s, box-shadow 0.2s, transform 0.2s;
}
.stat-card--hover {
  border: 1rpx solid rgba(168, 230, 54, 0.4);
  box-shadow: 0 16rpx 48rpx rgba(0, 0, 0, 0.7), 0 0 0 2rpx rgba(168,230,54,0.1);
  transform: scale(1.02) translateY(-6rpx);
}

/* 图标区 */
.stat-icon-wrap {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 小书本图标 */
.book-icon-mini {
  display: flex;
  width: 56rpx;
  height: 72rpx;
  border-radius: 4rpx 10rpx 10rpx 4rpx;
  overflow: hidden;
  box-shadow: 4rpx 6rpx 16rpx rgba(0,0,0,0.5), inset 0 2rpx 0 rgba(255,255,255,0.1);
}
.bk-spine {
  width: 14rpx;
  background: linear-gradient(180deg, #C5F243, #7ED321);
  flex-shrink: 0;
}
.bk-spine--blue {
  background: linear-gradient(180deg, #60bfff, #2a80d4);
}
.bk-body {
  flex: 1;
  background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(210,210,210,0.9));
  padding: 10rpx 8rpx;
  display: flex;
  flex-direction: column;
  gap: 7rpx;
  justify-content: center;
}
.bk-line {
  height: 4rpx;
  background: rgba(0,0,0,0.18);
  border-radius: 4rpx;
}
.bk-line--short {
  width: 65%;
}

/* 箭头徽章 */
.arrow-chip {
  position: absolute;
  bottom: -4rpx;
  right: -4rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 900;
  color: #000;
}
.arrow-up   { background: #A8E636; }
.arrow-down { background: #A8E636; }

/* 心形 */
.heart-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.heart-char {
  font-size: 64rpx;
  color: #A8E636;
  text-shadow: 0 0 24rpx rgba(168,230,54,0.6);
  line-height: 1;
}

/* stat 数值 & 标签 */
.stat-value {
  font-size: 60rpx;
  font-weight: 900;
  color: #A8E636;
  line-height: 1;
  letter-spacing: -1rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #B0B0B0;
  font-weight: 400;
}

/* ══════════════════════════════════════
   通用卡片
══════════════════════════════════════ */
.card {
  background: linear-gradient(135deg, #2a2a2a 0%, #181818 100%);
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 4rpx 24rpx rgba(0,0,0,0.5), inset 0 2rpx 0 rgba(255,255,255,0.04);
  position: relative;
  overflow: hidden;
}

/* 卡片顶部光泽线 */
.card-shine {
  position: absolute;
  top: 0;
  left: 15%;
  right: 15%;
  height: 1rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.08), transparent);
  border-radius: 1rpx;
}

/* ══════════════════════════════════════
   今日阅读目标
══════════════════════════════════════ */
.goal-card {
  margin: 28rpx 28rpx 0;
  padding: 36rpx;
}

.goal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.goal-title-wrap {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.goal-date-tag {
  font-size: 20rpx;
  color: #555555;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.goal-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #ffffff;
}

.goal-pct-badge {
  background: rgba(168, 230, 54, 0.12);
  border: 1rpx solid rgba(168, 230, 54, 0.28);
  border-radius: 60rpx;
  padding: 10rpx 24rpx;
}

.goal-pct-text {
  font-size: 36rpx;
  font-weight: 900;
  color: #A8E636;
}

/* ── 进度条 ── */
.progress-track {
  height: 16rpx;
  background: #2D2D2D;
  border-radius: 8rpx;
  overflow: visible;
  position: relative;
}

.progress-fill {
  height: 100%;
  border-radius: 8rpx;
  background: linear-gradient(90deg, #A8E636, #C5F243);
  box-shadow: 0 0 16rpx rgba(168,230,54,0.6), 0 0 32rpx rgba(168,230,54,0.25);
  transition: width 1.1s ease-out;
  position: relative;
}

/* 进度条末端呼吸光 */
.progress-glow-tip {
  position: absolute;
  right: -4rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #C5F243;
  box-shadow: 0 0 20rpx 6rpx rgba(197,242,67,0.7);
  animation: breathe 1.6s ease-in-out infinite;
}

@keyframes breathe {
  0%, 100% { opacity: 0.6; transform: translateY(-50%) scale(1); }
  50%       { opacity: 1;   transform: translateY(-50%) scale(1.3); }
}

/* ── 进度状态文字 ── */
.goal-footer {
  display: flex;
  justify-content: space-between;
  margin-top: 24rpx;
}

.goal-status-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.status-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
}
.dot-lime { background: #A8E636; }
.dot-dark { background: #3A3A3A; border: 2rpx solid #555; }

.goal-status-text {
  font-size: 24rpx;
  color: #888888;
}
.text-lime { color: #A8E636; font-weight: 600; }
.text-gray { color: #B0B0B0; }

/* ══════════════════════════════════════
   功能入口 2×2 宫格
══════════════════════════════════════ */
.func-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: 28rpx 28rpx 0;
  box-sizing: border-box;
}

.func-card {
  background: #181818;
  border-radius: 32rpx;
  padding: 36rpx 20rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.05);
  box-shadow: 0 4rpx 28rpx rgba(0,0,0,0.55), inset 0 2rpx 0 rgba(255,255,255,0.04);
  position: relative;
  overflow: hidden;
  transition: border 0.2s, box-shadow 0.2s, transform 0.2s;
}
.func-card--hover {
  border: 1rpx solid rgba(168, 230, 54, 0.35);
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.7);
  transform: scale(0.97);
}

/* 图标区 */
.func-icon-area {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 大书本图标 */
.book-icon-lg {
  display: flex;
  width: 72rpx;
  height: 96rpx;
  border-radius: 6rpx 14rpx 14rpx 6rpx;
  overflow: hidden;
  box-shadow: 4rpx 8rpx 24rpx rgba(0,0,0,0.5), inset 0 2rpx 0 rgba(255,255,255,0.12);
}
.bk-spine-lg {
  width: 18rpx;
  background: linear-gradient(180deg, #C5F243, #7ED321);
  flex-shrink: 0;
}
.bk-spine-lg.bk-spine--blue {
  background: linear-gradient(180deg, #60bfff, #2a80d4);
}
.bk-body-lg {
  flex: 1;
  background: linear-gradient(180deg, rgba(255,255,255,0.95), rgba(210,210,210,0.9));
  padding: 12rpx 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  justify-content: center;
}
.bk-line-lg {
  height: 5rpx;
  background: rgba(0,0,0,0.18);
  border-radius: 4rpx;
}

.func-arrow-chip {
  position: absolute;
  bottom: 2rpx;
  right: 2rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #A8E636;
  color: #000;
  font-size: 24rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 12rpx rgba(168,230,54,0.5);
}

/* 大心形 */
.heart-lg-wrap {
  width: 100rpx;
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.heart-lg-char {
  font-size: 100rpx;
  color: #A8E636;
  text-shadow: 0 0 30rpx rgba(168,230,54,0.7);
  line-height: 1;
}

.func-label {
  font-size: 28rpx;
  color: #B0B0B0;
  font-weight: 400;
}

/* 角标 */
.func-badge {
  position: absolute;
  top: 18rpx;
  right: 18rpx;
  background: #A8E636;
  color: #000000;
  font-size: 22rpx;
  font-weight: 800;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0 14rpx rgba(168,230,54,0.6);
}

/* ══════════════════════════════════════
   个人资料卡片
══════════════════════════════════════ */
.profile-card {
  margin: 28rpx 28rpx 0;
}

/* 头部信息 */
.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 36rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}

.avatar-wrap {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  flex-shrink: 0;
}
.avatar-wrap::before {
  content: '';
  position: absolute;
  inset: -3rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #A8E636, #7ED321);
  z-index: 0;
}
.avatar-wrap::after {
  content: '';
  position: absolute;
  inset: 3rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #333, #555);
  z-index: 1;
}
.avatar-char {
  position: absolute;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  font-weight: 900;
  color: #A8E636;
  z-index: 2;
  text-align: center;
  line-height: 100rpx;
}

.avatar-image {
  position: absolute;
  inset: 3rpx;
  border-radius: 50%;
  width: calc(100% - 6rpx);
  height: calc(100% - 6rpx);
  z-index: 2;
  object-fit: cover;
}
.avatar-ring {
  position: absolute;
  inset: -6rpx;
  border-radius: 50%;
  box-shadow: 0 0 20rpx rgba(168,230,54,0.35);
  z-index: 3;
}

.profile-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}
.profile-name {
  font-size: 36rpx;
  font-weight: 800;
  color: #ffffff;
}

.stars-row {
  display: flex;
  align-items: center;
  gap: 4rpx;
}
.star {
  font-size: 26rpx;
}
.star--on  { color: #FFD700; }
.star--off { color: #333; }
.star-score {
  font-size: 24rpx;
  color: #FFD700;
  font-weight: 700;
  margin-left: 6rpx;
}

.edit-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 18rpx;
  background: rgba(168, 230, 54, 0.1);
  border: 1rpx solid rgba(168, 230, 54, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.edit-btn--hover { opacity: 0.7; transform: scale(0.93); }
.edit-icon { font-size: 32rpx; }

/* 数据统计行 */
.profile-stats-row {
  display: flex;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.05);
}
.profile-stat-cell {
  flex: 1;
  padding: 28rpx 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
}
.profile-stat-cell.has-border {
  border-right: 1rpx solid rgba(255, 255, 255, 0.05);
}
.profile-stat-value {
  font-size: 44rpx;
  font-weight: 900;
  color: #A8E636;
}
.profile-stat-label {
  font-size: 22rpx;
  color: #666666;
}

/* 菜单列表 */
.menu-list {
  padding: 0 10rpx;
}
.menu-row {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 30rpx 24rpx;
  transition: background 0.15s;
}
.menu-row--bordered {
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.04);
}
.menu-row--hover {
  background: rgba(168, 230, 54, 0.04);
}

.menu-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  background: rgba(168, 230, 54, 0.08);
  border: 1rpx solid rgba(168, 230, 54, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.menu-icon-emoji { font-size: 36rpx; }

.menu-row-label {
  flex: 1;
  font-size: 30rpx;
  color: #DDDDDD;
  font-weight: 400;
}
.menu-row-value {
  font-size: 26rpx;
  color: #A8E636;
  font-weight: 600;
  margin-right: 6rpx;
}
.menu-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.2);
  line-height: 1;
}

/* ══════════════════════════════════════
   微信登录按钮
══════════════════════════════════════ */
.wechat-login-wrap {
  margin: 28rpx 28rpx 20rpx;
  padding: 0;
  box-sizing: border-box;
}
.wechat-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  padding: 30rpx;
  background: linear-gradient(135deg, #6BBF00 0%, #A8E636 50%, #C5F243 100%);
  border: 2rpx solid rgba(168, 230, 54, 0.35);
  border-radius: 100rpx;
  transition: background 0.15s, border 0.15s;
  min-height: 100rpx;
  width: 100%;
  box-sizing: border-box;
  position: relative;
  z-index: 10;
}
.wechat-btn--hover {
  background: linear-gradient(135deg, #5AA300 0%, #97D12E 50%, #B6E03A 100%);
  border-color: rgba(168, 230, 54, 0.6);
  transform: scale(0.98);
}
.wechat-emoji { font-size: 36rpx; }
.wechat-btn-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}

/* 购物车悬浮按钮（固定位置，下滑不跑偏） */
.cart-floating-button {
  position: fixed;
  bottom: 140rpx;
  right: 30rpx;
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25), 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
  z-index: 99;
}

.cart-floating-button:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-icon {
  font-size: 44rpx;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffd93d;
  color: #2d3436;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}