<!-- components/custom-tab-bar/index.wxml -->
<view class="tab-bar-container">
  <view class="tab-bar-item {{selected === 0 ? 'active' : ''}}" bindtap="switchTab" data-index="0" data-path="/pages/index/index">
    <view class="tab-bar-icon">🏠</view>
    <view class="tab-bar-text">首页</view>
  </view>
  
  <view class="tab-bar-item {{selected === 1 ? 'active' : ''}}" bindtap="switchTab" data-index="1" data-path="/pages/books/books">
    <view class="tab-bar-icon">📚</view>
    <view class="tab-bar-text">书籍</view>
  </view>
  
  <view class="tab-bar-publish">
    <view class="publish-button" bindtap="switchTab" data-index="2" data-path="/pages/publish/publish">
      <view class="publish-icon">+</view>
    </view>
  </view>
  
  <view class="tab-bar-item {{selected === 3 ? 'active' : ''}}" bindtap="switchTab" data-index="3" data-path="/pages/profile/profile">
    <view class="tab-bar-icon">👤</view>
    <view class="tab-bar-text">我的</view>
  </view>
</view>