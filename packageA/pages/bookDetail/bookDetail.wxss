/* bookDetail.wxss - 糖果立绘风格 */
.container {
  padding: 0;
  margin: 0;
  box-sizing: border-box;
  background: linear-gradient(180deg, #FFF5F5 0%, #FFF0F3 100%);
  min-height: 100vh;
  overflow-y: auto;
  -webkit-overflow-scrolling: touch;
}

/* Header with Back Button */
.header {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(10rpx);
  z-index: 100;
  box-shadow: 0 4rpx 16rpx rgba(255, 143, 163, 0.1);
  transition: all 0.3s ease;
}

.back-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border-radius: 50%;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #FFCDD8;
}

.back-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 50%;
}

.back-button:active {
  transform: scale(0.95);
  background: #FFD6E0;
}

.back-icon {
  font-size: 32rpx;
  font-weight: bold;
  color: #FF758F;
  position: relative;
  z-index: 1;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-button {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border-radius: 50%;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
  border: 2rpx solid #FFCDD8;
}

.action-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 50%;
}

.action-button:active {
  transform: scale(0.95);
  background: #FFD6E0;
}

.action-icon {
  font-size: 28rpx;
  position: relative;
  z-index: 1;
}

/* Book Images */
.images-section {
  margin-top: 104rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 24rpx;
  border-bottom: 2rpx solid #FFE5EC;
  position: relative;
}

.main-image {
  width: 100%;
  height: 480rpx;
  border-radius: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(255, 143, 163, 0.15);
  transition: all 0.3s ease;
}

.image-thumbs {
  display: flex;
  gap: 16rpx;
  overflow-x: auto;
  padding-bottom: 16rpx;
  scrollbar-width: none;
  -ms-overflow-style: none;
}

.image-thumbs::-webkit-scrollbar {
  display: none;
}

.thumb-item {
  width: 120rpx;
  height: 160rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 3rpx solid #FFE5EC;
  transition: all 0.3s ease;
  box-shadow: 0 4rpx 12rpx rgba(255, 143, 163, 0.1);
}

.thumb-item.active {
  border-color: #FF8FA3;
  box-shadow: 0 6rpx 16rpx rgba(255, 143, 163, 0.25);
  transform: scale(1.05);
}

.thumb-item:active {
  transform: scale(0.98);
}

.thumb-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

/* Book Info */
.info-section {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 28rpx;
  border-bottom: 2rpx solid #FFE5EC;
  position: relative;
}

.info-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #FFE5EC 50%, transparent 100%);
}

.price-info {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.current-price {
  font-size: 52rpx;
  font-weight: 700;
  color: #FF8FA3;
  text-shadow: 0 2rpx 6rpx rgba(255, 143, 163, 0.2);
}

.original-price {
  font-size: 28rpx;
  color: #9ca3af;
  text-decoration: line-through;
}

.book-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 12rpx;
  line-height: 1.3;
}

.book-author {
  font-size: 26rpx;
  color: #6b7280;
  margin-bottom: 24rpx;
}

.book-tags {
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
  flex-wrap: wrap;
}

.tag {
  font-size: 22rpx;
  padding: 8rpx 22rpx;
  border-radius: 22rpx;
  font-weight: 600;
  transition: all 0.3s ease;
}

.condition-tag {
  background: linear-gradient(135deg, #FFE5EC 0%, #FFD6E0 100%);
  border: 1rpx solid #FFCDD8;
  color: #FF758F;
}

.category-tag {
  background: linear-gradient(135deg, #E8F5E9 0%, #C8E6C9 100%);
  border: 1rpx solid #A5D6A7;
  color: #4CAF50;
}

.book-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding-top: 16rpx;
  border-top: 2rpx solid #FFE5EC;
}

.meta-item {
  font-size: 22rpx;
  color: #6b7280;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.meta-label {
  font-weight: 500;
  color: #9ca3af;
}

/* Seller Info */
.seller-section {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 28rpx;
  margin-top: 16rpx;
  border-bottom: 2rpx solid #FFE5EC;
  position: relative;
  transition: all 0.3s ease;
}

.seller-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #FFE5EC 50%, transparent 100%);
}

.seller-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  transition: all 0.3s ease;
}

.seller-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  margin-right: 20rpx;
  border: 4rpx solid #FFE5EC;
  box-shadow: 0 4rpx 12rpx rgba(255, 143, 163, 0.15);
  transition: all 0.3s ease;
}

.seller-avatar:active {
  transform: scale(1.05);
}

.seller-details {
  flex: 1;
}

.seller-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 8rpx;
}

.seller-rating {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.star {
  font-size: 24rpx;
}

.rating-value {
  font-size: 24rpx;
  color: #6b7280;
  font-weight: 600;
}

.books-sold {
  font-size: 20rpx;
  color: #9ca3af;
}

.contact-button {
  padding: 18rpx 36rpx;
  background: linear-gradient(135deg, #FF8FA3 0%, #FF758F 100%);
  color: #ffffff;
  border-radius: 28rpx;
  font-size: 24rpx;
  font-weight: 700;
  box-shadow: 0 6rpx 16rpx rgba(255, 143, 163, 0.35);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.contact-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.25) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 28rpx;
}

.contact-button:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 10rpx rgba(255, 143, 163, 0.25);
}

.contact-text {
  color: #ffffff;
  position: relative;
  z-index: 1;
}

/* Book Description */
.description-section {
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 28rpx;
  margin-top: 16rpx;
  margin-bottom: 180rpx;
  border-bottom: 2rpx solid #FFE5EC;
  position: relative;
}

.description-section::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 1rpx;
  background: linear-gradient(90deg, transparent 0%, #FFE5EC 50%, transparent 100%);
}

.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1f2937;
  margin-bottom: 20rpx;
  position: relative;
  display: inline-block;
}

.section-title::after {
  content: '';
  position: absolute;
  bottom: -10rpx;
  left: 0;
  width: 80rpx;
  height: 6rpx;
  background: linear-gradient(90deg, #FF8FA3 0%, #D4A5FF 100%);
  border-radius: 3rpx;
}

.description {
  font-size: 26rpx;
  color: #4b5563;
  line-height: 1.7;
  white-space: pre-wrap;
}

/* Action Section */
.action-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  padding: 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(255, 143, 163, 0.12);
  z-index: 99;
  transition: all 0.3s ease;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
}

.primary-button {
  flex: 1;
  padding: 30rpx;
  background: linear-gradient(135deg, #FF8FA3 0%, #FF758F 100%);
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(255, 143, 163, 0.35);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.primary-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 32rpx;
}

.primary-button:active {
  transform: scale(0.98);
  box-shadow: 0 3rpx 12rpx rgba(255, 143, 163, 0.25);
}

.secondary-button {
  flex: 1;
  padding: 30rpx;
  background: linear-gradient(145deg, #FFFFFF 0%, #FFF8F9 100%);
  border: 2rpx solid #FFE5EC;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 700;
  color: #FF8FA3;
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.secondary-button::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.8) 0%, rgba(255, 255, 255, 0) 100%);
  border-radius: 32rpx;
}

.secondary-button:active {
  transform: scale(0.98);
  background: #FFF0F3;
}

.button-text {
  color: inherit;
  position: relative;
  z-index: 1;
}

/* 购物车悬浮按钮 */
.cart-floating-button {
  background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
  border: 6rpx solid #ffffff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100rpx;
  height: 100rpx;
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.25), 0 3rpx 8rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.cart-floating-button:active {
  transform: scale(0.9);
  box-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-icon {
  font-size: 44rpx;
  color: #ffffff;
  text-shadow: 2rpx 2rpx 4rpx rgba(0, 0, 0, 0.3);
}

.cart-badge {
  position: absolute;
  top: -10rpx;
  right: -10rpx;
  background: #ffd93d;
  color: #2d3436;
  font-size: 22rpx;
  font-weight: 700;
  min-width: 36rpx;
  height: 36rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #ffffff;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.2);
}

/* Responsive Design */
@media (max-width: 375px) {
  .main-image {
    height: 400rpx;
  }

  .current-price {
    font-size: 44rpx;
  }

  .book-title {
    font-size: 32rpx;
  }

  .action-buttons {
    gap: 16rpx;
  }

  .primary-button,
  .secondary-button {
    padding: 26rpx;
    font-size: 26rpx;
  }
}

/* Animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.info-section,
.seller-section,
.description-section {
  animation: fadeIn 0.5s ease-out;
}

/* Loading State */
.loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 256rpx 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid #FFE5EC;
  border-top: 6rpx solid #FF8FA3;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin-bottom: 32rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.loading-text {
  font-size: 24rpx;
  color: #6b7280;
}
